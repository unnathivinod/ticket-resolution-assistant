# Copy this file to ".env" before starting:   copy .env.example .env
# ".env" holds your local settings and is never pushed to GitHub.

# ---- PostgreSQL (source of truth) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=tickets
POSTGRES_PORT=5432

# ---- Qdrant (vector database) ----
QDRANT_PORT=6333

# ---- Redis (cache + queue) ----
REDIS_PORT=6379

# ---- Embedding model (text -> meaning vectors) ----
# After changing it: docker compose build embedding, docker compose up -d,
# then reload the data with: docker compose run --rm tools python scripts/seed.py --recreate
EMBEDDING_DENSE_MODEL=BAAI/bge-small-en-v1.5

# ---- Language model (writes the resolution) ----
# Default: Ollama running on this machine. Any OpenAI-compatible API works: change the URL,
# the model name and the key. Set LLM_ENABLED=false to run without a model: the answer is then
# quoted directly from the best matching source.
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=not-needed

# Optional: a fast hosted model first, with Ollama as the backup. To use it, replace the three
# lines above with the block below (remove the "# ") and paste your own key. Groq has a free plan:
# create a key at https://console.groq.com/keys . Never put a real key in this example file or on
# GitHub; .env is not uploaded. With no key, leave everything as it is: Ollama answers.
#
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=paste-your-key-here
# LLM_TIMEOUT_SECONDS=30
# LLM_REASONING_EFFORT=low
# LLM_EXTRA_TOKENS=1000
# LLM_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
# LLM_FALLBACK_MODEL=llama3.2:3b
#
# LLM_TIMEOUT_SECONDS    a hosted model answers in seconds: give up early and ask the backup
# LLM_REASONING_EFFORT   gpt-oss thinks before it answers; "low" keeps that short
# LLM_EXTRA_TOKENS       room for that thinking, on top of the answer
# LLM_FALLBACK_*         the backup model, asked only if the first one fails
# true = the model must confirm that the best source is about the same problem before it writes
# steps. Leave false with llama3.2:3b (it then refuses everything). Try it with a larger model.
LLM_MATCH_CHECK=false

# ---- API access ----
# Comma-separated keys accepted by the gateway, and the key the UI uses. Change both for real use.
API_KEYS=dev-local-key
UI_API_KEY=dev-local-key
RATE_LIMIT_PER_MINUTE=30
# Keys that may also change data (add tickets and articles, manage ticket classes),
# and the one the tools container uses for evals.
ADMIN_API_KEYS=dev-admin-key
TOOLS_ADMIN_API_KEY=dev-admin-key
# The key the web page uses for the "record the real fix" form. Set it to nothing to hide the form.
UI_ADMIN_API_KEY=dev-admin-key

# ---- Checkpoints ----
# Second "does the best source really fit?" check, scored by the cross-encoder. 0 = off.
# Choose the value from: docker compose run --rm tools python evals/eval_relevance_gate.py
MIN_RELEVANCE=0

# ---- Our services ----
EMBEDDING_PORT=8004
RETRIEVAL_PORT=8002
TRIAGE_PORT=8001
GENERATION_PORT=8003
GATEWAY_PORT=8000
INGESTION_METRICS_PORT=8005

# ---- Monitoring ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
UI_PORT=8501
