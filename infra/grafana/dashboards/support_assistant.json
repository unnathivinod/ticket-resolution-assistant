          "expr": "sum(rate(gateway_resolve_total{outcome=\"escalated_no_match\"}[15m])) / sum(rate(gateway_resolve_total{outcome!=\"analyzed_only\"}[15m]))",
          "legendFormat": "escalated",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
