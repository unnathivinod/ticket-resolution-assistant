        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gateway_feedback_total{helpful=\"true\"}[6h])) / sum(increase(gateway_feedback_total[6h]))",
          "legendFormat": "helpful",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Category corrected by agents",
      "description": "Share of rated answers where the agent changed the category.",
      "datasource": {
