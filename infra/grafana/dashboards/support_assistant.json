          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gateway_top_similarity_bucket[15m])))",
          "legendFormat": "typical (p50)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.1, sum by (le) (rate(gateway_top_similarity_bucket[15m])))",
          "legendFormat": "least familiar 10%",
          "refId": "B"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Complaints with no confident match",
      "description": "Share that was escalated because nothing similar exists in the knowledge base.",
      "datasource": {
        "type": "prometheus",
